# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Database ----
# Dev (docker compose up -d): postgres/postgres @ localhost:5433
# Cổng 5433 (không phải 5432 mặc định) để tránh xung đột với PostgreSQL
# cài sẵn (native) đang chạy trên máy Windows ở cổng 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/learnquiz_db?schema=public"

# ---- JWT ----
JWT_ACCESS_SECRET=thay-bang-chuoi-ngau-nhien-cua-ban-vi-du-openssl-rand-hex-32
JWT_REFRESH_SECRET=thay-bang-chuoi-ngau-nhien-KHAC-voi-JWT_ACCESS_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- CORS ----
FE_URL=http://localhost:5173

# ---- AI (Sprint 5) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
